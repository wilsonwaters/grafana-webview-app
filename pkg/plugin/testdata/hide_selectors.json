{
  "description": "Hide selectors and whether the proxy accepts them. pkg/plugin/hide_selectors_test.go checks the backend (checkHideSelectors) and src/panels/webview/hideSelectors.test.ts checks the panel editor against this one table, so the two cannot drift. A refused case names a piece of text that the message must contain.",
  "cases": [
    { "selector": ".ad", "allowed": true },
    { "selector": "#site-header", "allowed": true },
    { "selector": "div", "allowed": true },
    { "selector": "*", "allowed": true },
    { "selector": "div.banner > .close", "allowed": true },
    { "selector": "header nav a", "allowed": true },
    { "selector": "ul li + li", "allowed": true },
    { "selector": "h1 ~ p", "allowed": true },
    { "selector": "a[href^=\"https://ads.\"]", "allowed": true },
    { "selector": "[data-x=\"a > b, c\"]", "allowed": true },
    { "selector": "div[data-role='x:has(y)']", "allowed": true },
    { "selector": "a[href!=\"/\"]", "allowed": true },
    { "selector": "[lang|=en]", "allowed": true },
    { "selector": "li:first-child", "allowed": true },
    { "selector": "LI:LAST-CHILD", "allowed": true },
    { "selector": "li:only-child", "allowed": true },
    { "selector": "p:first-of-type", "allowed": true },
    { "selector": "p:last-of-type", "allowed": true },
    { "selector": "p:only-of-type", "allowed": true },
    { "selector": "tr:nth-child(2n+1)", "allowed": true },
    { "selector": "tr:nth-child(odd)", "allowed": true },
    { "selector": "li:nth-last-child(2)", "allowed": true },
    { "selector": "p:nth-of-type(3)", "allowed": true },
    { "selector": "p:nth-last-of-type(even)", "allowed": true },
    { "selector": "div:empty", "allowed": true },
    { "selector": ":root", "allowed": true },
    { "selector": "a:link", "allowed": true },
    { "selector": "input:checked", "allowed": true },
    { "selector": "div:not(.keep)", "allowed": true },
    { "selector": "div:not(.a, #b)", "allowed": true },
    { "selector": "div:not(:first-child)", "allowed": true },
    { "selector": "div:not( .a )", "allowed": true },
    { "selector": "div:not(:not(.a))", "allowed": true },
    { "selector": ".a, .b, .c", "allowed": true },
    { "selector": ".a\\:b", "allowed": true },
    { "selector": "#\\31 23", "allowed": true },
    { "selector": "div/* a comment */ > p", "allowed": true },
    { "selector": "div:has(p)", "allowed": false, "reason": ":has()" },
    { "selector": "body:has(p) p", "allowed": false, "reason": ":has()" },
    { "selector": "div:haschild(p)", "allowed": false, "reason": ":haschild()" },
    { "selector": "p:contains(\"Ad\")", "allowed": false, "reason": ":contains()" },
    { "selector": "p:containsOwn(Ad)", "allowed": false, "reason": ":containsOwn()" },
    { "selector": "p:matches(^Ad)", "allowed": false, "reason": ":matches()" },
    { "selector": "p:matchesOwn(^Ad)", "allowed": false, "reason": ":matchesOwn()" },
    { "selector": "div:not(:has(p))", "allowed": false, "reason": ":has()" },
    { "selector": ".a, div:has(p)", "allowed": false, "reason": ":has()" },
    { "selector": ":H\\41 S(p)", "allowed": false, "reason": ":has()" },
    { "selector": "div:not(.a .b)", "allowed": false, "reason": ":not()" },
    { "selector": "div:not(.a > .b)", "allowed": false, "reason": ":not()" },
    { "selector": "div:not(.a/**/.b)", "allowed": false, "reason": ":not()" },
    { "selector": "[href#=(ads)]", "allowed": false, "reason": "#=" },
    { "selector": "p:lang(en)", "allowed": false, "reason": ":lang()" },
    { "selector": "a:hover", "allowed": false, "reason": ":hover" },
    { "selector": "input:enabled", "allowed": false, "reason": ":enabled" },
    { "selector": "input:disabled", "allowed": false, "reason": ":disabled" },
    { "selector": ":input", "allowed": false, "reason": ":input" }
  ]
}

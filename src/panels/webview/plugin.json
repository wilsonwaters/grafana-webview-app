{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Web View",
  "id": "wilsonwaters-webview-panel",
  "skipDataQuery": true,
  "info": {
    "description": "Embed an external web page in a dashboard panel with a controllable viewport.",
    "author": {
      "name": "Wilsonwaters",
      "url": "https://github.com/wilsonwaters"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Documentation",
        "url": "https://github.com/wilsonwaters/grafana-webview-app#readme"
      },
      {
        "name": "Repository",
        "url": "https://github.com/wilsonwaters/grafana-webview-app"
      },
      {
        "name": "Issues",
        "url": "https://github.com/wilsonwaters/grafana-webview-app/issues"
      }
    ],
    "screenshots": [
      {
        "name": "Web View panels in a dashboard",
        "path": "img/screenshots/dashboard.png"
      },
      {
        "name": "Panel editor with the viewport preview",
        "path": "img/screenshots/panel-editor.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "keywords": ["webview", "iframe", "embed"]
  },
  "dependencies": {
    "grafanaDependency": ">=12.4.0",
    "plugins": []
  }
}
